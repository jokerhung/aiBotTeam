{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "server/.venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "botteam.main:app", "--app-dir", "server", "--host", "127.0.0.1", "--port", "8899"],
