# Copy to .env and adjust. Read by `pnpm dev` (scripts/run.mjs).
SERVER_PORT=8899
WEB_PORT=5299
WEBHOOK_PORT=8900
SERVER_HOST=127.0.0.1
# Set WEB_HOST=0.0.0.0 to access port 5299 via LAN or Tailscale.
# The API stays on loopback and is reached through the web proxy.
# Remote mode requires the pairing code printed in the server console.
WEB_HOST=127.0.0.1
# Optional additional DNS names (comma-separated, no scheme or port).
# WEB_ALLOWED_HOSTS=my-machine.my-tailnet.ts.net
