# Copy to .env and adjust. Read by `pnpm dev` (scripts/run.mjs).
SERVER_PORT=8899
WEB_PORT=5299
WEBHOOK_PORT=8900
# The Node.js Zalo service (zalo-service/), reached through the web app's /zalo-api proxy. It listens on 127.0.0.1 only.
ZALO_PORT=8902
SERVER_HOST=127.0.0.1
# Set WEB_HOST=0.0.0.0 to access port 5299 via LAN or Tailscale.
# The API stays on loopback and is reached through the web proxy.
# Domain access requires the pairing code in the console; localhost/LAN/Tailscale IPs open directly.
WEB_HOST=127.0.0.1
# Optional additional DNS names (comma-separated, no scheme or port).
# WEB_ALLOWED_HOSTS=my-machine.my-tailnet.ts.net

# Web use uses a per-agent browser profile and pinned @playwright/mcp@0.0.86 (Node.js/npx required).
# Per-agent headed/local-network/idle controls live in Toolbox, not environment variables.
# Optional Computer use: uv sync --project server --extra computer (Python 3.11+).
# Configure ONE provider in Settings > Computer host; these variables override saved settings.
# E2B_API_KEY=
# E2B_API_URL=https://api.e2b.dev
# E2B_SANDBOX_URL=
# E2B_DOMAIN=
# BOTTEAM_COMPUTER_TEMPLATE=desktop
# OPENSANDBOX_URL=http://your-host:8080
# OPENSANDBOX_API_KEY=
# BOTTEAM_COMPUTER_IMAGE=botteam/desktop:1
# BOTTEAM_COMPUTER_IDLE_S=900
